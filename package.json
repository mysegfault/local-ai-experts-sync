{
  "name": "local-ai-experts-sync",
  "productName": "Local AI Experts Sync",
  "version": "0.3.0",
  "description": "A friendly cross-platform Git sync app for non-technical users",
  "main": "src/main/main.js",
  "author": "Local AI Experts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:i18n": "node scripts/i18n-test.js",
    "test:detect": "node scripts/git-detect-test.js",
    "test:discard": "node scripts/discard-test.js",
    "test:update": "node scripts/update-test.js",
    "test:smoke": "xvfb-run -a electron scripts/smoke.js",
    "test:e2e": "xvfb-run -a electron scripts/e2e.js",
    "test:cred": "xvfb-run -a electron scripts/cred-e2e.js",
    "test": "npm run test:i18n && npm run test:detect && npm run test:discard && npm run test:update && npm run test:smoke && npm run test:e2e && npm run test:cred",
    "pack:dir": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
